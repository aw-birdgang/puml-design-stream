@startuml msa_step4_apigateway

title OfficeNow MSA - API Gateway (Simplified)

actor "Users" as U
actor "Admin" as A

package "Client Layer" {
  [Web App] as WA
  [Mobile App] as MA
  [Admin Dashboard] as AD
}

package "API Gateway" {
  [Kong Gateway] as AG
}

package "Core Services" {
  [Auth Service] as AS
  [User Service] as US
  [Parking Service] as PS
  [Facility Service] as FS
  [Energy Service] as ES
  [Community Service] as CS
}

' Client connections
U --> WA
U --> MA
A --> AD

' Gateway connections
WA --> AG
MA --> AG
AD --> AG

' Service routing
AG --> AS : /auth
AG --> US : /users
AG --> PS : /parking
AG --> FS : /facility
AG --> ES : /energy
AG --> CS : /community

note right of AG
  Kong API Gateway
  - Authentication
  - Routing
  - Rate Limiting
end note

@enduml
