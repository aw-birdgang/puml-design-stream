@startuml
skinparam backgroundColor #FFFFFF
skinparam sequence {
    ArrowColor #3E8ED0
    ActorBorderColor #3E8ED0
    ActorBackgroundColor #E6F2FF
    ParticipantBorderColor #3E8ED0
    ParticipantBackgroundColor #E6F2FF
    BoxBackgroundColor #F8F8F8
    BoxBorderColor #C0C0C0
    LifeLineBorderColor #3E8ED0
    LifeLineBackgroundColor #FFFFFF
    SequenceFontName Arial
    SequenceFontSize 12
    SequenceFontColor #333333
}

actor Developer as Dev #lightblue
actor Reviewer as Rev #orange

box "Crucible System" #lightgrey
    participant Repo as "Repository"
    participant Crucible as "Crucible Review System"
end box

Dev -> Repo : Commit Changes
Dev -> Crucible : Import Code from Repository
Crucible -> Dev : Confirm Code Upload

Dev -> Crucible : Create Review
Crucible -> Rev : Assign Reviewers and Notify

Rev -> Crucible : Add Line-by-Line Comments
Crucible -> Dev : Notify Feedback

alt Revisions Needed
    Dev -> Repo : Apply Fixes
    Dev -> Crucible : Update Code in Review
    Crucible -> Rev : Notify Updates
else Approved
    Rev -> Crucible : Approve Review
end

Crucible -> Dev : Notify Approval Completion

@enduml
