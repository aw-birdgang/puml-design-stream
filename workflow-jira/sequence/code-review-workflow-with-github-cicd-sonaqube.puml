@startuml
skinparam backgroundColor #FFFFFF
skinparam sequence {
    ArrowColor #3E8ED0
    ActorBorderColor #3E8ED0
    ActorBackgroundColor #E6F2FF
    ParticipantBorderColor #3E8ED0
    ParticipantBackgroundColor #E6F2FF
    BoxBackgroundColor #F8F8F8
    BoxBorderColor #C0C0C0
    LifeLineBorderColor #3E8ED0
    LifeLineBackgroundColor #FFFFFF
    SequenceFontName Arial
    SequenceFontSize 12
    SequenceFontColor #333333
}

actor Developer as Dev #lightblue
actor Reviewer as Rev #orange

box "GitHub System" #lightgrey
    participant Repo as "GitHub Repository"
    participant PR as "Pull Request System"
end box

box "CI/CD System" #lightgreen
    participant CI as "CI/CD Pipeline"
end box

box "SonarQube System" #lightyellow
    participant SonarServer as "SonarQube Server"
    participant Dashboard as "SonarQube Dashboard"
end box

Dev -> Repo : Commit Changes
Dev -> PR : Create Pull Request
PR -> Dev : Confirm PR Creation

PR -> CI : Trigger CI/CD Pipeline
CI -> SonarServer : Run Static Analysis
SonarServer -> Dashboard : Upload Analysis Results
Dashboard -> CI : Report Analysis Status (Pass/Fail)

alt CI/CD or SonarQube Fails
    Dashboard -> Dev : Notify Issues (Bugs, Vulnerabilities, Code Smells)
    Dev -> Repo : Apply Fixes
    Dev -> PR : Push Updates to PR
    PR -> CI : Re-run CI/CD Pipeline
else CI/CD and SonarQube Pass
    PR -> Rev : Notify Reviewer
    Rev -> PR : Add Comments or Approve PR
end

alt Revisions Needed
    Rev -> Dev : Request Changes
    Dev -> Repo : Commit Fixes
    Dev -> PR : Update PR
    PR -> Rev : Notify Updates
else Approved
    Rev -> PR : Approve PR
    Dev -> PR : Merge PR
    PR -> Dev : Notify Merge Completion
end

@enduml
